<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreMaterialCategoryMapper">

	<resultMap type="CoreMaterialCategory" id="CoreMaterialCategoryResult">
		<id     property="id"               column="id"                />
		<result property="categoryName"     column="category_name"     />
		<result property="packageType"      column="package_type"      />
		<result property="sortOrder"        column="sort_order"        />
		<result property="status"           column="status"            />
		<result property="createBy"         column="create_by"         />
		<result property="createTime"       column="create_time"       />
		<result property="updateBy"         column="update_by"         />
		<result property="updateTime"       column="update_time"       />
		<result property="remark"           column="remark"            />
	</resultMap>

	<sql id="selectCoreMaterialCategoryVo">
        select id, category_name, package_type, sort_order, status, create_by, create_time, update_by, update_time, remark
		from core_material_category
    </sql>

	<select id="selectCoreMaterialCategoryList" parameterType="CoreMaterialCategory" resultMap="CoreMaterialCategoryResult">
		<include refid="selectCoreMaterialCategoryVo"/>
		<where>
			<if test="categoryName != null and categoryName != ''">
				AND category_name like concat('%', #{categoryName}, '%')
			</if>
			<if test="packageType != null">
				AND package_type = #{packageType}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by package_type, sort_order, id
	</select>

	<select id="selectCoreMaterialCategoryByPackageType" parameterType="Integer" resultMap="CoreMaterialCategoryResult">
		<include refid="selectCoreMaterialCategoryVo"/>
		where package_type = #{packageType}
		and status = '0'
		order by sort_order, id
	</select>

	<select id="selectAllActiveCategory" resultMap="CoreMaterialCategoryResult">
		<include refid="selectCoreMaterialCategoryVo"/>
		where status = '0'
		order by package_type, sort_order, id
	</select>

	<select id="selectCoreMaterialCategoryById" parameterType="Long" resultMap="CoreMaterialCategoryResult">
		<include refid="selectCoreMaterialCategoryVo"/>
		where id = #{id}
	</select>

	<insert id="insertCoreMaterialCategory" parameterType="CoreMaterialCategory" useGeneratedKeys="true" keyProperty="id">
 		insert into core_material_category
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="categoryName != null and categoryName != ''">category_name,</if>
			<if test="packageType != null">package_type,</if>
			<if test="sortOrder != null">sort_order,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="categoryName != null and categoryName != ''">#{categoryName},</if>
			<if test="packageType != null">#{packageType},</if>
			<if test="sortOrder != null">#{sortOrder},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		</trim>
	</insert>

	<update id="updateCoreMaterialCategory" parameterType="CoreMaterialCategory">
 		update core_material_category
 		<set>
			<if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
			<if test="packageType != null">package_type = #{packageType},</if>
			<if test="sortOrder != null">sort_order = #{sortOrder},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

	<delete id="deleteCoreMaterialCategoryById" parameterType="Long">
		delete from core_material_category where id = #{id}
	</delete>

	<delete id="deleteCoreMaterialCategoryByIds" parameterType="Long">
		delete from core_material_category where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>
