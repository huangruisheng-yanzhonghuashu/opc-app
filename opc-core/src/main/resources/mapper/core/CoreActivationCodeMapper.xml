<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreActivationCodeMapper">

    <resultMap type="com.opc.core.domain.CoreActivationCode" id="CoreActivationCodeResult">
        <result property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="validDays" column="valid_days"/>
        <result property="expireTime" column="expire_time"/>
        <result property="channelTag" column="channel_tag"/>
        <result property="batchNo" column="batch_no"/>
        <result property="status" column="status"/>
        <result property="sendTime" column="send_time"/>
        <result property="useTime" column="use_time"/>
        <result property="useUserId" column="use_user_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectCoreActivationCodeVo">
        select id, code, valid_days, expire_time, channel_tag, batch_no, status, send_time, use_time, use_user_id, create_by, create_time, update_by, update_time, remark
        from core_activation_code
    </sql>

    <select id="selectCoreActivationCodeById" parameterType="Long" resultMap="CoreActivationCodeResult">
        <include refid="selectCoreActivationCodeVo"/>
        where id = #{id}
    </select>

    <select id="selectCoreActivationCodeList" parameterType="com.opc.core.domain.CoreActivationCode" resultMap="CoreActivationCodeResult">
        <include refid="selectCoreActivationCodeVo"/>
        <where>
            <if test="code != null and code != ''">
                and code like concat('%', #{code}, '%')
            </if>
            <if test="channelTag != null and channelTag != ''">
                and channel_tag like concat('%', #{channelTag}, '%')
            </if>
            <if test="batchNo != null and batchNo != ''">
                and batch_no = #{batchNo}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <insert id="insertCoreActivationCode" parameterType="com.opc.core.domain.CoreActivationCode" useGeneratedKeys="true" keyProperty="id">
        insert into core_activation_code
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="validDays != null">valid_days,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="channelTag != null">channel_tag,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="status != null">status,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="useTime != null">use_time,</if>
            <if test="useUserId != null">use_user_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="validDays != null">#{validDays},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="channelTag != null">#{channelTag},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="status != null">#{status},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="useTime != null">#{useTime},</if>
            <if test="useUserId != null">#{useUserId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <insert id="batchInsertCoreActivationCode">
        insert into core_activation_code (code, valid_days, expire_time, channel_tag, batch_no, status, create_by, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.code}, #{item.validDays}, #{item.expireTime}, #{item.channelTag}, #{item.batchNo}, #{item.status}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>

    <update id="updateCoreActivationCode" parameterType="com.opc.core.domain.CoreActivationCode">
        update core_activation_code
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="validDays != null">valid_days = #{validDays},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="channelTag != null">channel_tag = #{channelTag},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sendTime != null">send_time = #{sendTime},</if>
            <if test="useTime != null">use_time = #{useTime},</if>
            <if test="useUserId != null">use_user_id = #{useUserId},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="batchUpdateStatus">
        update core_activation_code
        set status = #{status},
            update_time = sysdate()
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="batchUpdateStatusAndSendTime">
        update core_activation_code
        set status = #{status},
            send_time = #{sendTime},
            update_time = sysdate()
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="deleteCoreActivationCodeById" parameterType="Long">
        delete from core_activation_code where id = #{id}
    </delete>

    <delete id="deleteCoreActivationCodeByIds">
        delete from core_activation_code where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectCoreActivationCodeByCode" parameterType="String" resultMap="CoreActivationCodeResult">
        <include refid="selectCoreActivationCodeVo"/>
        where code = #{code}
    </select>

    <update id="updateActivationCodeUsed">
        update core_activation_code
        set status = #{status},
            use_time = #{useTime},
            use_user_id = #{useUserId},
            update_time = sysdate()
        where code = #{code}
    </update>

</mapper>
