<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreActivityMapper">

	<resultMap type="CoreActivity" id="CoreActivityResult">
		<id     property="id"                column="id"                  />
		<result property="activityName"      column="activity_name"       />
		<result property="posterUrl"         column="poster_url"          />
		<result property="organizerName"     column="organizer_name"      />
		<result property="organizerAvatar"   column="organizer_avatar"    />
		<result property="activityTime"      column="activity_time"       />
		<result property="province"          column="province"            />
		<result property="city"              column="city"                />
		<result property="address"           column="address"             />
		<result property="totalCapacity"     column="total_capacity"      />
		<result property="registeredCount"   column="registered_count"    />
		<result property="registrationFee"   column="registration_fee"    />
		<result property="activityDetail"    column="activity_detail"     />
		<result property="status"            column="status"              />
		<result property="createBy"          column="create_by"          />
		<result property="createTime"        column="create_time"        />
		<result property="updateBy"          column="update_by"          />
		<result property="updateTime"        column="update_time"        />
		<result property="remark"            column="remark"             />
	</resultMap>

	<sql id="selectActivityVo">
        select id, activity_name, poster_url, organizer_name, organizer_avatar,
               activity_time, province, city, address, total_capacity, registered_count,
               registration_fee, activity_detail, status,
               create_by, create_time, update_by, update_time, remark
		from core_activity
    </sql>

	<select id="selectActivityList" parameterType="CoreActivity" resultMap="CoreActivityResult">
		<include refid="selectActivityVo"/>
		<where>
			<if test="activityName != null and activityName != ''">
				AND activity_name like concat('%', #{activityName}, '%')
			</if>
			<if test="province != null and province != ''">
				AND province = #{province}
			</if>
			<if test="city != null and city != ''">
				AND city = #{city}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''">
				AND activity_time &gt;= #{params.beginTime}
			</if>
			<if test="params.endTime != null and params.endTime != ''">
				AND activity_time &lt;= #{params.endTime}
			</if>
		</where>
		order by activity_time desc, create_time desc
	</select>

	<select id="selectActivityById" parameterType="Long" resultMap="CoreActivityResult">
		<include refid="selectActivityVo"/>
		where id = #{id}
	</select>

	<update id="updateActivity" parameterType="CoreActivity">
 		update core_activity
 		<set>
 			<if test="activityName != null and activityName != ''">activity_name = #{activityName},</if>
 			<if test="posterUrl != null">poster_url = #{posterUrl},</if>
 			<if test="organizerName != null">organizer_name = #{organizerName},</if>
 			<if test="organizerAvatar != null">organizer_avatar = #{organizerAvatar},</if>
 			<if test="activityTime != null">activity_time = #{activityTime},</if>
 			<if test="province != null">province = #{province},</if>
 			<if test="city != null">city = #{city},</if>
 			<if test="address != null">address = #{address},</if>
 			<if test="totalCapacity != null">total_capacity = #{totalCapacity},</if>
 			<if test="registeredCount != null">registered_count = #{registeredCount},</if>
 			<if test="registrationFee != null">registration_fee = #{registrationFee},</if>
 			<if test="activityDetail != null">activity_detail = #{activityDetail},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

 	<insert id="insertActivity" parameterType="CoreActivity" useGeneratedKeys="true" keyProperty="id">
 		insert into core_activity(
 			<if test="id != null and id != 0">id,</if>
 			<if test="activityName != null and activityName != ''">activity_name,</if>
 			<if test="posterUrl != null">poster_url,</if>
 			<if test="organizerName != null">organizer_name,</if>
 			<if test="organizerAvatar != null">organizer_avatar,</if>
 			<if test="activityTime != null">activity_time,</if>
 			<if test="province != null">province,</if>
 			<if test="city != null">city,</if>
 			<if test="address != null">address,</if>
 			<if test="totalCapacity != null">total_capacity,</if>
 			<if test="registeredCount != null">registered_count,</if>
 			<if test="registrationFee != null">registration_fee,</if>
 			<if test="activityDetail != null">activity_detail,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="remark != null">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="id != null and id != 0">#{id},</if>
 			<if test="activityName != null and activityName != ''">#{activityName},</if>
 			<if test="posterUrl != null">#{posterUrl},</if>
 			<if test="organizerName != null">#{organizerName},</if>
 			<if test="organizerAvatar != null">#{organizerAvatar},</if>
 			<if test="activityTime != null">#{activityTime},</if>
 			<if test="province != null">#{province},</if>
 			<if test="city != null">#{city},</if>
 			<if test="address != null">#{address},</if>
 			<if test="totalCapacity != null">#{totalCapacity},</if>
 			<if test="registeredCount != null">#{registeredCount},</if>
 			<if test="registrationFee != null">#{registrationFee},</if>
 			<if test="activityDetail != null">#{activityDetail},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="remark != null">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<delete id="deleteActivityById" parameterType="Long">
		delete from core_activity where id = #{id}
	</delete>

	<delete id="deleteActivityByIds" parameterType="Long">
		delete from core_activity where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

	<update id="changeStatus" parameterType="CoreActivity">
		update core_activity
		set status = #{status},
		    update_time = sysdate()
		where id = #{id}
	</update>

</mapper>
