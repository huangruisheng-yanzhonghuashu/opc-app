<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreActivityBannerMapper">

	<resultMap type="CoreActivityBanner" id="CoreActivityBannerResult">
		<id     property="id"                column="id"                  />
		<result property="bannerName"        column="banner_name"         />
		<result property="imageUrl"          column="image_url"           />
		<result property="activityId"        column="activity_id"         />
		<result property="sortOrder"         column="sort_order"          />
		<result property="status"            column="status"              />
		<result property="createBy"          column="create_by"          />
		<result property="createTime"        column="create_time"        />
		<result property="updateBy"          column="update_by"          />
		<result property="updateTime"        column="update_time"        />
		<result property="remark"            column="remark"             />
	</resultMap>

	<sql id="selectActivityBannerVo">
        select id, banner_name, image_url, activity_id, sort_order, status,
               create_by, create_time, update_by, update_time, remark
		from core_activity_banner
    </sql>

	<select id="selectActivityBannerList" parameterType="CoreActivityBanner" resultMap="CoreActivityBannerResult">
		<include refid="selectActivityBannerVo"/>
		<where>
			<if test="bannerName != null and bannerName != ''">
				AND banner_name like concat('%', #{bannerName}, '%')
			</if>
			<if test="activityId != null">
				AND activity_id = #{activityId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by sort_order asc, create_time desc
	</select>

	<select id="selectActivityBannerById" parameterType="Long" resultMap="CoreActivityBannerResult">
		<include refid="selectActivityBannerVo"/>
		where id = #{id}
	</select>

	<update id="updateActivityBanner" parameterType="CoreActivityBanner">
 		update core_activity_banner
 		<set>
 			<if test="bannerName != null">banner_name = #{bannerName},</if>
 			<if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
 			<if test="activityId != null">activity_id = #{activityId},</if>
 			<if test="sortOrder != null">sort_order = #{sortOrder},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

 	<insert id="insertActivityBanner" parameterType="CoreActivityBanner" useGeneratedKeys="true" keyProperty="id">
 		insert into core_activity_banner(
 			<if test="id != null and id != 0">id,</if>
 			<if test="bannerName != null">banner_name,</if>
 			<if test="imageUrl != null and imageUrl != ''">image_url,</if>
 			<if test="activityId != null">activity_id,</if>
 			<if test="sortOrder != null">sort_order,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="remark != null">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="id != null and id != 0">#{id},</if>
 			<if test="bannerName != null">#{bannerName},</if>
 			<if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
 			<if test="activityId != null">#{activityId},</if>
 			<if test="sortOrder != null">#{sortOrder},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="remark != null">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<delete id="deleteActivityBannerById" parameterType="Long">
		delete from core_activity_banner where id = #{id}
	</delete>

	<delete id="deleteActivityBannerByIds" parameterType="Long">
		delete from core_activity_banner where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

	<update id="changeStatus" parameterType="CoreActivityBanner">
		update core_activity_banner
		set status = #{status},
		    update_time = sysdate()
		where id = #{id}
	</update>

</mapper>
