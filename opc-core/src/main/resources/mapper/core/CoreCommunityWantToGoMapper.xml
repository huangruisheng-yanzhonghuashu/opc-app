<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreCommunityWantToGoMapper">

	<resultMap type="CoreCommunityWantToGo" id="CoreCommunityWantToGoResult">
		<id     property="id"              column="id"                   />
		<result property="communityId"     column="community_id"         />
		<result property="memberId"        column="member_id"            />
		<result property="status"          column="status"               />
		<result property="createBy"        column="create_by"            />
		<result property="createTime"      column="create_time"          />
		<result property="updateBy"        column="update_by"            />
		<result property="updateTime"      column="update_time"          />
		<result property="remark"          column="remark"               />
	</resultMap>

	<sql id="selectVo">
        select id, community_id, member_id, status,
               create_by, create_time, update_by, update_time, remark
		from core_community_want_to_go
    </sql>

	<select id="selectList" parameterType="CoreCommunityWantToGo" resultMap="CoreCommunityWantToGoResult">
		<include refid="selectVo"/>
		<where>
			<if test="communityId != null">
				AND community_id = #{communityId}
			</if>
			<if test="memberId != null">
				AND member_id = #{memberId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by create_time desc
	</select>

	<select id="selectByCommunityId" parameterType="Long" resultMap="CoreCommunityWantToGoResult">
		<include refid="selectVo"/>
		where community_id = #{communityId} and status = '0'
		order by create_time desc
	</select>

	<select id="selectByMemberId" parameterType="Long" resultMap="CoreCommunityWantToGoResult">
		<include refid="selectVo"/>
		where member_id = #{memberId} and status = '0'
		order by create_time desc
	</select>

	<select id="selectById" parameterType="Long" resultMap="CoreCommunityWantToGoResult">
		<include refid="selectVo"/>
		where id = #{id}
	</select>

	<select id="selectByCommunityAndMember" resultMap="CoreCommunityWantToGoResult">
		<include refid="selectVo"/>
		where community_id = #{communityId}
		  and member_id = #{memberId}
	</select>

	<insert id="insert" parameterType="CoreCommunityWantToGo" useGeneratedKeys="true" keyProperty="id">
		insert into core_community_want_to_go(
			<if test="id != null and id != 0">id,</if>
			<if test="communityId != null">community_id,</if>
			<if test="memberId != null">member_id,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="id != null and id != 0">#{id},</if>
			<if test="communityId != null">#{communityId},</if>
			<if test="memberId != null">#{memberId},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="update" parameterType="CoreCommunityWantToGo">
 		update core_community_want_to_go
 		<set>
 			<if test="communityId != null">community_id = #{communityId},</if>
 			<if test="memberId != null">member_id = #{memberId},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

	<delete id="deleteById" parameterType="Long">
 		delete from core_community_want_to_go where id = #{id}
	</delete>

	<delete id="deleteByIds" parameterType="Long">
 		delete from core_community_want_to_go where id in
 		<foreach collection="array" item="id" open="(" separator="," close=")">
  			#{id}
 		</foreach>
	</delete>

	<update id="cancel" parameterType="Long">
		UPDATE core_community_want_to_go
		SET status = '1',
		    update_time = sysdate()
		WHERE id = #{id}
	</update>

	<select id="countByCommunityId" parameterType="Long" resultType="int">
		SELECT COUNT(*) FROM core_community_want_to_go
		WHERE community_id = #{communityId} AND status = '0'
	</select>

	<update id="updateCommunityWantToGoCount" parameterType="Long">
		UPDATE core_community c
		SET c.want_to_go_count = (
			SELECT COUNT(*) FROM core_community_want_to_go w
			WHERE w.community_id = c.id AND w.status = '0'
		)
		WHERE c.id = #{communityId}
	</update>

</mapper>
