<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreCustomerServiceMapper">

    <resultMap type="CoreCustomerService" id="CoreCustomerServiceResult">
        <id     property="id"              column="id"                />
        <result property="serviceName"     column="service_name"      />
        <result property="qrCodeUrl"       column="qr_code_url"       />
        <result property="wechatId"        column="wechat_id"         />
        <result property="phone"           column="phone"             />
        <result property="isDefault"       column="is_default"        />
        <result property="status"          column="status"            />
        <result property="sortOrder"       column="sort_order"        />
        <result property="createBy"        column="create_by"         />
        <result property="createTime"      column="create_time"       />
        <result property="updateBy"        column="update_by"         />
        <result property="updateTime"      column="update_time"       />
        <result property="remark"          column="remark"            />
    </resultMap>

    <sql id="selectCustomerServiceVo">
        select id, service_name, qr_code_url, wechat_id, phone, is_default, status, sort_order,
               create_by, create_time, update_by, update_time, remark
        from core_customer_service
    </sql>

    <select id="selectCustomerServiceList" parameterType="CoreCustomerService" resultMap="CoreCustomerServiceResult">
        <include refid="selectCustomerServiceVo"/>
        <where>
            <if test="serviceName != null and serviceName != ''">
                AND service_name like concat('%', #{serviceName}, '%')
            </if>
            <if test="wechatId != null and wechatId != ''">
                AND wechat_id like concat('%', #{wechatId}, '%')
            </if>
            <if test="isDefault != null and isDefault != ''">
                AND is_default = #{isDefault}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort_order asc, id desc
    </select>

    <select id="selectCustomerServiceById" parameterType="Long" resultMap="CoreCustomerServiceResult">
        <include refid="selectCustomerServiceVo"/>
        where id = #{id}
    </select>

    <select id="selectDefaultCustomerService" resultMap="CoreCustomerServiceResult">
        <include refid="selectCustomerServiceVo"/>
        where is_default = '0' and status = '0'
        limit 1
    </select>

    <insert id="insertCustomerService" parameterType="CoreCustomerService" useGeneratedKeys="true" keyProperty="id">
        insert into core_customer_service(
            <if test="id != null and id != 0">id,</if>
            <if test="serviceName != null and serviceName != ''">service_name,</if>
            <if test="qrCodeUrl != null">qr_code_url,</if>
            <if test="wechatId != null">wechat_id,</if>
            <if test="phone != null">phone,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="id != null and id != 0">#{id},</if>
            <if test="serviceName != null and serviceName != ''">#{serviceName},</if>
            <if test="qrCodeUrl != null">#{qrCodeUrl},</if>
            <if test="wechatId != null">#{wechatId},</if>
            <if test="phone != null">#{phone},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCustomerService" parameterType="CoreCustomerService">
        update core_customer_service
        <set>
            <if test="serviceName != null and serviceName != ''">service_name = #{serviceName},</if>
            <if test="qrCodeUrl != null">qr_code_url = #{qrCodeUrl},</if>
            <if test="wechatId != null">wechat_id = #{wechatId},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteCustomerServiceById" parameterType="Long">
        delete from core_customer_service where id = #{id}
    </delete>

    <delete id="deleteCustomerServiceByIds">
        delete from core_customer_service where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="cancelAllDefault">
        update core_customer_service set is_default = '1'
    </update>

</mapper>
