<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opc.core.mapper.CoreCommunityReviewMapper">

	<resultMap type="CoreCommunityReview" id="CoreCommunityReviewResult">
		<id     property="id"              column="id"                   />
		<result property="communityId"     column="community_id"         />
		<result property="memberId"        column="member_id"            />
		<result property="rating"          column="rating"               />
		<result property="content"         column="content"              />
		<result property="images"          column="images"               />
		<result property="status"          column="status"               />
		<result property="likeCount"       column="like_count"           />
		<result property="createBy"        column="create_by"            />
		<result property="createTime"      column="create_time"          />
		<result property="updateBy"        column="update_by"            />
		<result property="updateTime"      column="update_time"          />
		<result property="remark"          column="remark"               />
	</resultMap>

	<sql id="selectReviewVo">
        select id, community_id, member_id, rating, content, images,
               status, like_count, create_by, create_time, update_by, update_time, remark
		from core_community_review
    </sql>

	<select id="selectReviewList" parameterType="CoreCommunityReview" resultMap="CoreCommunityReviewResult">
		<include refid="selectReviewVo"/>
		<where>
			<if test="communityId != null">
				AND community_id = #{communityId}
			</if>
			<if test="memberId != null">
				AND member_id = #{memberId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="content != null and content != ''">
				AND content like concat('%', #{content}, '%')
			</if>
		</where>
		order by create_time desc
	</select>

	<select id="selectReviewsByCommunityId" parameterType="Long" resultMap="CoreCommunityReviewResult">
		<include refid="selectReviewVo"/>
		where community_id = #{communityId} and status = '0'
		order by create_time desc
	</select>

	<select id="selectReviewById" parameterType="Long" resultMap="CoreCommunityReviewResult">
		<include refid="selectReviewVo"/>
		where id = #{id}
	</select>

	<insert id="insertReview" parameterType="CoreCommunityReview" useGeneratedKeys="true" keyProperty="id">
		insert into core_community_review(
			<if test="id != null and id != 0">id,</if>
			<if test="communityId != null">community_id,</if>
			<if test="memberId != null">member_id,</if>
			<if test="rating != null">rating,</if>
			<if test="content != null">content,</if>
			<if test="images != null">images,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="likeCount != null">like_count,</if>
			<if test="remark != null">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="id != null and id != 0">#{id},</if>
			<if test="communityId != null">#{communityId},</if>
			<if test="memberId != null">#{memberId},</if>
			<if test="rating != null">#{rating},</if>
			<if test="content != null">#{content},</if>
			<if test="images != null">#{images},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="likeCount != null">#{likeCount},</if>
			<if test="remark != null">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateReview" parameterType="CoreCommunityReview">
 		update core_community_review
 		<set>
 			<if test="communityId != null">community_id = #{communityId},</if>
 			<if test="memberId != null">member_id = #{memberId},</if>
 			<if test="rating != null">rating = #{rating},</if>
 			<if test="content != null">content = #{content},</if>
 			<if test="images != null">images = #{images},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="likeCount != null">like_count = #{likeCount},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

	<delete id="deleteReviewById" parameterType="Long">
 		delete from core_community_review where id = #{id}
	</delete>

	<delete id="deleteReviewByIds" parameterType="Long">
 		delete from core_community_review where id in
 		<foreach collection="array" item="id" open="(" separator="," close=")">
  			#{id}
 		</foreach>
	</delete>

	<select id="getReviewStatsByCommunityId" parameterType="Long" resultType="Map">
		SELECT
			COUNT(*) as review_count,
			IFNULL(AVG(rating), 5.0) as avg_rating
		FROM core_community_review
		WHERE community_id = #{communityId}
		  AND status = '0'
	</select>

	<update id="updateCommunityReviewStats" parameterType="Long">
		UPDATE core_community c
		SET c.review_count = (
			SELECT COUNT(*) FROM core_community_review r
			WHERE r.community_id = c.id AND r.status = '0'
		),
		c.rating = (
			SELECT IFNULL(AVG(rating), 5.0) FROM core_community_review r
			WHERE r.community_id = c.id AND r.status = '0'
		)
		WHERE c.id = #{communityId}
	</update>

	<select id="selectByMemberAndCommunityIds" resultMap="CoreCommunityReviewResult">
		<include refid="selectReviewVo"/>
		WHERE member_id = #{memberId}
		  AND community_id IN
		<foreach collection="communityIds" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
		AND status = '0'
	</select>

</mapper>
